reviewer_role: "シニアソフトウェアエンジニア"
tech_stack: "TypeScript, Node.js, GitHub Actions"
review_focus: "確実なバグ、壊れる変更、パフォーマンス劣化"
additional_rules: |
  憶測ではなく、現在の差分から断定できる問題のみ指摘してください。
default_model: "gpt-5-mini"
file_priorities:
  ts: 10
  js: 9
  yml: 8
  json: 7
exclude_patterns:
  - "**/dist/**"
comment_language: "ja"
